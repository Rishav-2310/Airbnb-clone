<%- include('../partials/head') %>
    </head>

    <body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col font-sans antialiased">
        <%- include('../partials/nav') %>

            <main class="grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">

                <% if (updated) { %>
                    <div id="toast-success"
                        class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-center justify-between shadow-sm transition">
                        <div class="flex items-center space-x-3">
                            <div
                                class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold">
                                ✓</div>
                            <div>
                                <p class="font-bold text-sm">Profile updated successfully!</p>
                                <p class="text-xs text-emerald-600">Your profile information and details have been
                                    saved.</p>
                            </div>
                        </div>
                        <button onclick="document.getElementById('toast-success').remove()"
                            class="text-emerald-500 hover:text-emerald-700 font-bold text-lg">&times;</button>
                    </div>
                    <% } %>

                        <!-- Header -->
                        <header
                            class="mb-8 border-b border-gray-200 pb-5 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                            <div>
                                <h1 class="text-3xl font-extrabold text-gray-900">User Profile</h1>
                                <p class="mt-1 text-sm text-gray-600">Manage your profile, view personal details, and
                                    check your account activity.</p>
                            </div>
                            <div class="flex items-center space-x-3">
                                <button onclick="switchTab('edit')"
                                    class="inline-flex items-center px-4 py-2.5 bg-red-500 hover:bg-red-600 text-white font-semibold text-sm rounded-xl shadow transition cursor-pointer">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                    Edit Profile
                                </button>
                            </div>
                        </header>

                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                            <!-- Left Column: User Hero Card -->
                            <aside class="lg:col-span-4 space-y-6">
                                <div
                                    class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm flex flex-col items-center text-center relative overflow-hidden">
                                    <!-- Accent background banner decoration -->
                                    <div
                                        class="absolute top-0 left-0 right-0 h-24 bg-linear-to-r from-red-500 via-rose-500 to-pink-500 opacity-90">
                                    </div>

                                    <!-- Avatar Container -->
                                    <div class="relative mt-8 mb-4">
                                        <% if (userProfile.profilePicBuffer) { %>
                                            <img src="/user/avatar/<%= userProfile._id %>"
                                                alt="<%= userProfile.firstName %>"
                                                class="w-28 h-28 rounded-full object-cover border-4 border-white shadow-md">
                                            <% } else { %>
                                                <div
                                                    class="w-28 h-28 rounded-full bg-linear-to-tr from-red-500 to-rose-400 text-white flex items-center justify-center text-4xl font-extrabold border-4 border-white shadow-md">
                                                    <%= userProfile.firstName ?
                                                        userProfile.firstName.charAt(0).toUpperCase() : 'U' %>
                                                </div>
                                                <% } %>

                                                    <button onclick="switchTab('edit')" title="Update avatar photo"
                                                        class="absolute bottom-0 right-0 bg-gray-900 hover:bg-black text-white p-2 rounded-full shadow border-2 border-white transition">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor"
                                                            viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                                stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        </svg>
                                                    </button>
                                    </div>

                                    <!-- User Name & Role -->
                                    <h2 class="text-2xl font-black text-gray-900 tracking-tight">
                                        <%= userProfile.firstName %>
                                            <%= userProfile.lastName || '' %>
                                    </h2>

                                    <div class="mt-2 flex items-center gap-2">
                                        <% if (userProfile.userType==='host' ) { %>
                                            <span
                                                class="bg-purple-50 text-purple-700 border border-purple-200 text-xs font-extrabold uppercase px-3 py-1 rounded-full flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5 text-purple-600" fill="currentColor"
                                                    viewBox="0 0 20 20">
                                                    <path
                                                        d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l1.293 1.293a1 1 0 001.414-1.414l-7-7z" />
                                                </svg>
                                                Verified Host
                                            </span>
                                            <% } else { %>
                                                <span
                                                    class="bg-red-50 text-red-600 border border-red-200 text-xs font-extrabold uppercase px-3 py-1 rounded-full flex items-center gap-1">
                                                    <svg class="w-3.5 h-3.5 text-red-500" fill="currentColor"
                                                        viewBox="0 0 20 20">
                                                        <path d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" />
                                                    </svg>
                                                    Guest Explorer
                                                </span>
                                                <% } %>
                                    </div>

                                    <p class="text-xs text-gray-500 mt-3 flex items-center justify-center">
                                        <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor"
                                            viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        Joined <%= new Date(userProfile.joinedDate ||
                                            Date.now()).toLocaleDateString('en-US', { month: 'long' , year: 'numeric' })
                                            %>
                                    </p>

                                    <!-- Quick Counters Box -->
                                    <div
                                        class="w-full mt-6 grid grid-cols-3 gap-2 border-t border-b border-gray-100 py-4 text-center">
                                        <div>
                                            <span class="block text-xl font-black text-gray-900">
                                                <%= userProfile.bookings ? userProfile.bookings.length : 0 %>
                                            </span>
                                            <span class="text-xs font-medium text-gray-500">Bookings</span>
                                        </div>
                                        <div class="border-l border-r border-gray-100">
                                            <span class="block text-xl font-black text-gray-900">
                                                <%= userProfile.favourites ? userProfile.favourites.length : 0 %>
                                            </span>
                                            <span class="text-xs font-medium text-gray-500">Favourites</span>
                                        </div>
                                        <div>
                                            <span class="block text-xl font-black text-gray-900">
                                                <%= userProfile.userType==='host' && userProfile.myHomes ?
                                                    userProfile.myHomes.length : 0 %>
                                            </span>
                                            <span class="text-xs font-medium text-gray-500">
                                                <%= userProfile.userType==='host' ? 'My Homes' : 'Reviews' %>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Verified Features Badge Group -->
                                    <div class="w-full mt-6 space-y-2.5 text-left text-xs">
                                        <span
                                            class="text-gray-400 font-bold uppercase tracking-wider block mb-1">Identity
                                            Verification</span>
                                        <div
                                            class="flex items-center text-gray-700 bg-gray-50 p-2.5 rounded-xl border border-gray-100">
                                            <svg class="w-4 h-4 text-emerald-500 mr-2 shrink-0" fill="currentColor"
                                                viewBox="0 0 20 20">
                                                <path fill-rule="evenodd"
                                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                                    clip-rule="evenodd" />
                                            </svg>
                                            <span>Identity Confirmed</span>
                                        </div>
                                        <div
                                            class="flex items-center text-gray-700 bg-gray-50 p-2.5 rounded-xl border border-gray-100">
                                            <svg class="w-4 h-4 text-emerald-500 mr-2 shrink-0" fill="currentColor"
                                                viewBox="0 0 20 20">
                                                <path fill-rule="evenodd"
                                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                                    clip-rule="evenodd" />
                                            </svg>
                                            <span>Email Address Verified</span>
                                        </div>
                                        <div
                                            class="flex items-center text-gray-700 bg-gray-50 p-2.5 rounded-xl border border-gray-100">
                                            <svg class="w-4 h-4 <%= userProfile.phone ? 'text-emerald-500' : 'text-gray-300' %> mr-2 shrink-0"
                                                fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd"
                                                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                                    clip-rule="evenodd" />
                                            </svg>
                                            <span>
                                                <%= userProfile.phone ? 'Phone Number Provided'
                                                    : 'Phone Number Not Added' %>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Action Links -->
                                    <div class="w-full mt-6 space-y-2">
                                       <% if (userProfile.userType === 'guest') { %>
                                            <a href="/bookings"
                                                class="w-full py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-xl flex items-center justify-center transition">
                                                View All Bookings
                                            </a>
                                            <a href="/favourite-list"
                                                class="w-full py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-xl flex items-center justify-center transition">
                                                View Wishlist Favourites
                                            </a>
                                        <% } else { %>
                                            <a href="/host/host-home-list"
                                                class="w-full py-2.5 px-4 bg-gray-100 hover:bg-gray-200 text-gray-800 font-bold text-xs rounded-xl flex items-center justify-center transition">
                                                Manage My Homes
                                            </a>
                                            <% } %>
                                    </div>
                                </div>
                            </aside>

                            <!-- Right Column: Interactive Details & Tabs -->
                            <section class="lg:col-span-8 space-y-6">

                                <!-- Navigation Tabs Bar -->
                                <div class="bg-white rounded-2xl border border-gray-200 p-1.5 flex space-x-2 shadow-sm">
                                    <button id="tab-overview-btn" onclick="switchTab('overview')"
                                        class="flex-1 py-3 px-4 rounded-xl text-sm font-bold transition text-red-600 bg-red-50 shadow-sm flex items-center justify-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                        </svg>
                                        Overview & Details
                                    </button>
                                    <button id="tab-edit-btn" onclick="switchTab('edit')"
                                        class="flex-1 py-3 px-4 rounded-xl text-sm font-bold transition text-gray-600 hover:bg-gray-100 flex items-center justify-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                        Edit Profile
                                    </button>
                                    <button id="tab-activity-btn" onclick="switchTab('activity')"
                                        class="flex-1 py-3 px-4 rounded-xl text-sm font-bold transition text-gray-600 hover:bg-gray-100 flex items-center justify-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                        </svg>
                                        Account Summary
                                    </button>
                                </div>

                                <!-- TAB 1: OVERVIEW & DETAILS -->
                                <div id="tab-overview" class="space-y-6">

                                    <!-- Bio Box -->
                                    <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm">
                                        <div
                                            class="flex items-center justify-between border-b border-gray-100 pb-4 mb-4">
                                            <h3 class="text-xl font-bold text-gray-900 flex items-center">
                                                <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                                                </svg>
                                                About <%= userProfile.firstName %>
                                            </h3>
                                            <button onclick="switchTab('edit')"
                                                class="text-xs font-bold text-red-500 hover:text-red-600 underline">
                                                Edit Bio
                                            </button>
                                        </div>

                                        <% if (userProfile.bio) { %>
                                            <p class="text-gray-700 leading-relaxed text-sm whitespace-pre-line">
                                                <%= userProfile.bio %>
                                            </p>
                                            <% } else { %>
                                                <div
                                                    class="p-6 bg-gray-50 border border-dashed border-gray-200 rounded-2xl text-center">
                                                    <p class="text-sm text-gray-500">No bio added yet. Tell host members
                                                        and fellow guests about your interests, travels, or background!
                                                    </p>
                                                    <button onclick="switchTab('edit')"
                                                        class="mt-3 px-4 py-2 bg-red-500 text-white font-bold text-xs rounded-xl shadow hover:bg-red-600 transition">
                                                        + Add Bio
                                                    </button>
                                                </div>
                                                <% } %>
                                    </div>

                                    <!-- Personal Information Grid -->
                                    <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm">
                                        <h3
                                            class="text-xl font-bold text-gray-900 border-b border-gray-100 pb-4 mb-6 flex items-center">
                                            <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 012-2h2a2 2 0 012 2v1m-6 0h6" />
                                            </svg>
                                            Personal Details & Info
                                        </h3>

                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">

                                            <!-- Email -->
                                            <div class="p-4 bg-gray-50 rounded-2xl border border-gray-100">
                                                <span
                                                    class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Email
                                                    Address</span>
                                                <div class="flex items-center text-sm font-bold text-gray-900">
                                                    <svg class="w-4 h-4 text-gray-400 mr-2 shrink-0" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                                    </svg>
                                                    <span class="truncate">
                                                        <%= userProfile.email %>
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Phone -->
                                            <div class="p-4 bg-gray-50 rounded-2xl border border-gray-100">
                                                <span
                                                    class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Phone
                                                    Number</span>
                                                <div class="flex items-center text-sm font-bold text-gray-900">
                                                    <svg class="w-4 h-4 text-gray-400 mr-2 shrink-0" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                                                    </svg>
                                                    <span>
                                                        <%= userProfile.phone || 'Not provided' %>
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Location -->
                                            <div class="p-4 bg-gray-50 rounded-2xl border border-gray-100">
                                                <span
                                                    class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Location
                                                    / Hometown</span>
                                                <div class="flex items-center text-sm font-bold text-gray-900">
                                                    <svg class="w-4 h-4 text-gray-400 mr-2 shrink-0" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                                    </svg>
                                                    <span>
                                                        <%= userProfile.location || 'Not specified' %>
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Occupation -->
                                            <div class="p-4 bg-gray-50 rounded-2xl border border-gray-100">
                                                <span
                                                    class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Occupation
                                                    / Work</span>
                                                <div class="flex items-center text-sm font-bold text-gray-900">
                                                    <svg class="w-4 h-4 text-gray-400 mr-2 shrink-0" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                                                    </svg>
                                                    <span>
                                                        <%= userProfile.occupation || 'Not specified' %>
                                                    </span>
                                                </div>
                                            </div>

                                            <!-- Languages -->
                                            <div
                                                class="p-4 bg-gray-50 rounded-2xl border border-gray-100 sm:col-span-2">
                                                <span
                                                    class="text-xs font-bold uppercase tracking-wider text-gray-400 block mb-1">Languages
                                                    Spoken</span>
                                                <div class="flex items-center text-sm font-bold text-gray-900">
                                                    <svg class="w-4 h-4 text-gray-400 mr-2 shrink-0" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
                                                    </svg>
                                                    <span>
                                                        <%= userProfile.languages || 'English' %>
                                                    </span>
                                                </div>
                                            </div>

                                        </div>
                                    </div>

                                </div>

                                <!-- TAB 2: EDIT PROFILE FORM -->
                                <div id="tab-edit" class="hidden space-y-6">
                                    <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm">
                                        <div class="border-b border-gray-100 pb-4 mb-6">
                                            <h3 class="text-xl font-bold text-gray-900 flex items-center">
                                                <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                                Update Personal Details
                                            </h3>
                                            <p class="text-xs text-gray-500 mt-1">Keep your profile information accurate
                                                for smooth bookings and host communication.</p>
                                        </div>

                                        <form action="/profile/edit" method="POST" enctype="multipart/form-data"
                                            class="space-y-6">

                                            <!-- Profile Picture File Input -->
                                            <div
                                                class="p-5 bg-red-50/50 rounded-2xl border border-red-100 flex flex-col sm:flex-row items-center gap-4">
                                                <div
                                                    class="w-16 h-16 rounded-full overflow-hidden shrink-0 bg-gray-200 border-2 border-white shadow-sm">
                                                    <% if (userProfile.profilePicBuffer) { %>
                                                        <img id="avatar-preview"
                                                            src="/user/avatar/<%= userProfile._id %>"
                                                            class="w-full h-full object-cover">
                                                        <% } else { %>
                                                            <div id="avatar-preview-fallback"
                                                                class="w-full h-full bg-red-500 text-white flex items-center justify-center font-black text-xl">
                                                                <%= userProfile.firstName ?
                                                                    userProfile.firstName.charAt(0).toUpperCase() : 'U'
                                                                    %>
                                                            </div>
                                                            <img id="avatar-preview"
                                                                class="hidden w-full h-full object-cover">
                                                            <% } %>
                                                </div>
                                                <div class="grow text-center sm:text-left">
                                                    <label
                                                        class="block text-xs font-bold text-gray-800 uppercase tracking-wider mb-1">Profile
                                                        Photo</label>
                                                    <input type="file" name="profilePic" accept="image/*"
                                                        onchange="previewImage(event)"
                                                        class="text-xs text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-red-500 file:text-white hover:file:bg-red-600 transition cursor-pointer">
                                                    <p class="text-[11px] text-gray-400 mt-1">Upload a JPG, PNG, or WEBP
                                                        photo (max 5MB).</p>
                                                </div>
                                            </div>

                                            <!-- Name Fields -->
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                                <div>
                                                    <label
                                                        class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">First
                                                        Name *</label>
                                                    <input type="text" name="firstName"
                                                        value="<%= userProfile.firstName %>" required
                                                        class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm font-medium transition">
                                                </div>
                                                <div>
                                                    <label
                                                        class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Last
                                                        Name</label>
                                                    <input type="text" name="lastName"
                                                        value="<%= userProfile.lastName || '' %>"
                                                        class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm font-medium transition">
                                                </div>
                                            </div>

                                            <!-- Contact & Location Fields -->
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                                <div>
                                                    <label
                                                        class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Phone
                                                        Number</label>
                                                    <input type="tel" name="phone"
                                                        value="<%= userProfile.phone || '' %>"
                                                        placeholder="+1 (555) 000-0000"
                                                        class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm font-medium transition">
                                                </div>
                                                <div>
                                                    <label
                                                        class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Location
                                                        / City</label>
                                                    <input type="text" name="location"
                                                        value="<%= userProfile.location || '' %>"
                                                        placeholder="e.g. San Francisco, CA"
                                                        class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm font-medium transition">
                                                </div>
                                            </div>

                                            <!-- Occupation & Languages -->
                                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                                <div>
                                                    <label
                                                        class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Occupation
                                                        / Job</label>
                                                    <input type="text" name="occupation"
                                                        value="<%= userProfile.occupation || '' %>"
                                                        placeholder="e.g. Designer, Software Engineer"
                                                        class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm font-medium transition">
                                                </div>
                                                <div>
                                                    <label
                                                        class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Languages
                                                        Spoken</label>
                                                    <input type="text" name="languages"
                                                        value="<%= userProfile.languages || '' %>"
                                                        placeholder="e.g. English, Spanish, French"
                                                        class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm font-medium transition">
                                                </div>
                                            </div>

                                            <!-- Bio Textarea -->
                                            <div>
                                                <label
                                                    class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">About
                                                    / Bio</label>
                                                <textarea name="bio" rows="4"
                                                    placeholder="Share a few sentences about your travel style, hobbies, or hosting preferences..."
                                                    class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm font-medium transition"><%= userProfile.bio || '' %></textarea>
                                            </div>

                                            <!-- Form Buttons -->
                                            <div
                                                class="pt-4 border-t border-gray-100 flex items-center justify-end space-x-3">
                                                <button type="button" onclick="switchTab('overview')"
                                                    class="px-5 py-2.5 rounded-xl border border-gray-300 text-gray-700 text-sm font-bold hover:bg-gray-100 transition">
                                                    Cancel
                                                </button>
                                                <button type="submit"
                                                    class="px-6 py-2.5 rounded-xl bg-red-500 hover:bg-red-600 text-white text-sm font-bold shadow-md transition">
                                                    Save Changes
                                                </button>
                                            </div>

                                        </form>
                                    </div>
                                </div>

                                <!-- TAB 3: ACCOUNT SUMMARY & RECENT ACTIVITY -->
                                <div id="tab-activity" class="hidden space-y-6">

                                    <!-- Bookings Preview -->
                                    <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm">
                                        <div
                                            class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                                            <h3 class="text-xl font-bold text-gray-900 flex items-center">
                                                <svg class="w-5 h-5 text-red-500 mr-2" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                                </svg>
                                                Recent Reserved Trips
                                            </h3>
                                            <a href="/bookings"
                                                class="text-xs font-bold text-red-500 hover:underline">View All</a>
                                        </div>

                                        <% if (!userProfile.bookings || userProfile.bookings.length===0) { %>
                                            <div
                                                class="p-6 bg-gray-50 border border-dashed border-gray-200 rounded-2xl text-center">
                                                <p class="text-sm text-gray-500">You haven't made any bookings yet.</p>
                                                <a href="/homes"
                                                    class="mt-3 inline-block px-4 py-2 bg-red-500 text-white font-bold text-xs rounded-xl shadow hover:bg-red-600 transition">
                                                    Explore Stays
                                                </a>
                                            </div>
                                            <% } else { %>
                                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                                    <% userProfile.bookings.slice(0, 4).forEach(b=> { %>
                                                        <% if (b.home) { %>
                                                            <div
                                                                class="border border-gray-200 rounded-2xl overflow-hidden flex flex-col justify-between hover:shadow-md transition">
                                                                <div class="h-32 bg-gray-100 relative">
                                                                    <img src="/<%= b.home.photo %>"
                                                                        alt="<%= b.home.houseName %>"
                                                                        class="w-full h-full object-cover">
                                                                    <span
                                                                        class="absolute top-2 right-2 bg-green-600 text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full uppercase">
                                                                        Confirmed
                                                                    </span>
                                                                </div>
                                                                <div class="p-4">
                                                                    <h4
                                                                        class="font-bold text-sm text-gray-900 truncate">
                                                                        <%= b.home.houseName %>
                                                                    </h4>
                                                                    <p class="text-xs text-gray-500 mt-1">
                                                                        <%= b.checkIn %> → <%= b.checkOut %>
                                                                    </p>
                                                                    <div class="mt-3 flex items-center justify-between">
                                                                        <span
                                                                            class="text-xs font-black text-gray-900">Rs
                                                                            <%= b.totalPrice ?
                                                                                b.totalPrice.toLocaleString('en-IN') :
                                                                                b.home.price %>
                                                                        </span>
                                                                        <a href="/homes/<%= b.home._id %>"
                                                                            class="text-xs font-bold text-red-500 hover:underline">View</a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <% } %>
                                                                <% }) %>
                                                </div>
                                                <% } %>
                                    </div>

                                    <!-- Favourites Preview -->
                                    <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm">
                                        <div
                                            class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                                            <h3 class="text-xl font-bold text-gray-900 flex items-center">
                                                <svg class="w-5 h-5 text-red-500 mr-2" fill="currentColor"
                                                    viewBox="0 0 20 20">
                                                    <path fill-rule="evenodd"
                                                        d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                                                        clip-rule="evenodd" />
                                                </svg>
                                                Saved Wishlist Favourites
                                            </h3>
                                            <a href="/favourite-list"
                                                class="text-xs font-bold text-red-500 hover:underline">View Wishlist</a>
                                        </div>

                                        <% if (!userProfile.favourites || userProfile.favourites.length===0) { %>
                                            <div
                                                class="p-6 bg-gray-50 border border-dashed border-gray-200 rounded-2xl text-center">
                                                <p class="text-sm text-gray-500">Your wishlist is currently empty.</p>
                                                <a href="/homes"
                                                    class="mt-3 inline-block px-4 py-2 bg-red-500 text-white font-bold text-xs rounded-xl shadow hover:bg-red-600 transition">
                                                    Browse Homes to Save
                                                </a>
                                            </div>
                                            <% } else { %>
                                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                                    <% userProfile.favourites.slice(0, 3).forEach(fav=> { %>
                                                        <div
                                                            class="border border-gray-200 rounded-2xl overflow-hidden hover:shadow-md transition">
                                                            <div class="h-28 bg-gray-100">
                                                                <img src="/<%= fav.photo %>" alt="<%= fav.houseName %>"
                                                                    class="w-full h-full object-cover">
                                                            </div>
                                                            <div class="p-3">
                                                                <h4 class="font-bold text-xs text-gray-900 truncate">
                                                                    <%= fav.houseName %>
                                                                </h4>
                                                                <p class="text-[11px] text-gray-500 truncate">
                                                                    <%= fav.location %>
                                                                </p>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <% } %>
                                    </div>

                                    <% if (userProfile.userType==='host' ) { %>
                                        <!-- Hosted Homes Preview -->
                                        <div class="bg-white rounded-3xl border border-gray-200 p-6 sm:p-8 shadow-sm">
                                            <div
                                                class="flex items-center justify-between border-b border-gray-100 pb-4 mb-6">
                                                <h3 class="text-xl font-bold text-purple-900 flex items-center">
                                                    <svg class="w-5 h-5 text-purple-600 mr-2" fill="none"
                                                        stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round"
                                                            stroke-width="2"
                                                            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                                                    </svg>
                                                    My Hosted Listings
                                                </h3>
                                                <a href="/host/host-home-list"
                                                    class="text-xs font-bold text-purple-600 hover:underline">Manage
                                                    All</a>
                                            </div>

                                            <% if (!userProfile.myHomes || userProfile.myHomes.length===0) { %>
                                                <div
                                                    class="p-6 bg-purple-50 border border-dashed border-purple-200 rounded-2xl text-center">
                                                    <p class="text-sm text-purple-800 font-medium">You haven't listed
                                                        any homes yet.</p>
                                                    <a href="/host/add-home"
                                                        class="mt-3 inline-block px-4 py-2 bg-purple-600 text-white font-bold text-xs rounded-xl shadow hover:bg-purple-700 transition">
                                                        + Create New Listing
                                                    </a>
                                                </div>
                                                <% } else { %>
                                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                                        <% userProfile.myHomes.slice(0, 3).forEach(home=> { %>
                                                            <div
                                                                class="border border-purple-100 bg-purple-50/30 rounded-2xl overflow-hidden hover:shadow-md transition">
                                                                <div class="h-28 bg-gray-100">
                                                                    <img src="/<%= home.photo %>"
                                                                        alt="<%= home.houseName %>"
                                                                        class="w-full h-full object-cover">
                                                                </div>
                                                                <div class="p-3">
                                                                    <h4
                                                                        class="font-bold text-xs text-gray-900 truncate">
                                                                        <%= home.houseName %>
                                                                    </h4>
                                                                    <p
                                                                        class="text-[11px] font-bold text-purple-700 mt-0.5">
                                                                        Rs <%= home.price %> / night</p>
                                                                </div>
                                                            </div>
                                                            <% }) %>
                                                    </div>
                                                    <% } %>
                                        </div>
                                        <% } %>

                                </div>

                            </section>

                        </div>

            </main>

            <script>
                function switchTab(tabName) {
                    const overviewTab = document.getElementById('tab-overview');
                    const editTab = document.getElementById('tab-edit');
                    const activityTab = document.getElementById('tab-activity');

                    const overviewBtn = document.getElementById('tab-overview-btn');
                    const editBtn = document.getElementById('tab-edit-btn');
                    const activityBtn = document.getElementById('tab-activity-btn');

                    // Hide all tabs
                    overviewTab.classList.add('hidden');
                    editTab.classList.add('hidden');
                    activityTab.classList.add('hidden');

                    // Reset button styles
                    [overviewBtn, editBtn, activityBtn].forEach(btn => {
                        btn.classList.remove('text-red-600', 'bg-red-50', 'shadow-sm');
                        btn.classList.add('text-gray-600', 'hover:bg-gray-100');
                    });

                    // Show selected tab & highlight button
                    if (tabName === 'overview') {
                        overviewTab.classList.remove('hidden');
                        overviewBtn.classList.add('text-red-600', 'bg-red-50', 'shadow-sm');
                        overviewBtn.classList.remove('text-gray-600', 'hover:bg-gray-100');
                    } else if (tabName === 'edit') {
                        editTab.classList.remove('hidden');
                        editBtn.classList.add('text-red-600', 'bg-red-50', 'shadow-sm');
                        editBtn.classList.remove('text-gray-600', 'hover:bg-gray-100');
                    } else if (tabName === 'activity') {
                        activityTab.classList.remove('hidden');
                        activityBtn.classList.add('text-red-600', 'bg-red-50', 'shadow-sm');
                        activityBtn.classList.remove('text-gray-600', 'hover:bg-gray-100');
                    }
                }

                function previewImage(event) {
                    const file = event.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            const previewImg = document.getElementById('avatar-preview');
                            const fallback = document.getElementById('avatar-preview-fallback');
                            if (previewImg) {
                                previewImg.src = e.target.result;
                                previewImg.classList.remove('hidden');
                            }
                            if (fallback) {
                                fallback.classList.add('hidden');
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                }
            </script>
            <%- include('../partials/footer') %>
    </body>

    </html>