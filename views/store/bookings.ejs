<%- include('../partials/head') %>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex flex-col font-sans antialiased">
    <%- include('../partials/nav') %>

    <main class="grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <header class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 border-b border-gray-200 pb-5">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-900">My Bookings & Reservations</h1>
                <p class="mt-1 text-sm text-gray-600">View and manage your upcoming trips and stays.</p>
            </div>
            <div>
                <a href="/homes" class="inline-flex items-center px-4 py-2.5 bg-red-500 hover:bg-red-600 text-white font-semibold text-sm rounded-xl shadow transition">
                    + Explore More Homes
                </a>
            </div>
        </header>

        <% if (!bookings || bookings.length === 0) { %>
            <div class="bg-white border border-dashed border-gray-300 rounded-3xl p-12 text-center max-w-2xl mx-auto shadow-sm">
                <div class="w-20 h-20 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-900">No bookings yet</h2>
                <p class="mt-2 text-sm text-gray-500 max-w-md mx-auto">
                    When you reserve a home, your trip details, confirmation status, and host contacts will show up right here.
                </p>
                <div class="mt-6">
                    <a href="/homes" class="inline-block px-6 py-3 bg-red-500 hover:bg-red-600 text-white font-bold text-sm rounded-xl shadow transition">
                        Find a Place to Stay
                    </a>
                </div>
            </div>
        <% } else { %>
            <div class="space-y-6">
                <% bookings.forEach(booking => { %>
                    <% if (booking.home) { %>
                        <article class="bg-white rounded-3xl shadow-sm hover:shadow-md border border-gray-200 overflow-hidden transition">
                            <div class="grid grid-cols-1 lg:grid-cols-12">
                                
                                <!-- Image Preview Column -->
                                <div class="lg:col-span-4 h-56 lg:h-auto bg-gray-100 relative overflow-hidden">
                                    <img src="/<%= booking.home.photo %>" alt="<%= booking.home.houseName %>" class="w-full h-full object-cover">
                                    <div class="absolute top-4 left-4 bg-green-600 text-white text-xs font-extrabold uppercase px-3 py-1 rounded-full shadow">
                                        Confirmed
                                    </div>
                                </div>

                                <!-- Details Column -->
                                <div class="lg:col-span-8 p-6 sm:p-8 flex flex-col justify-between space-y-6">
                                    <div>
                                        <div class="flex items-start justify-between">
                                            <div>
                                                <span class="text-xs font-bold text-red-500 uppercase tracking-wider">Reserved Stay</span>
                                                <h3 class="text-2xl font-bold text-gray-900 mt-0.5"><%= booking.home.houseName %></h3>
                                                <p class="text-sm text-gray-500 mt-1 flex items-center">
                                                    <svg class="w-4 h-4 mr-1 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                                    </svg>
                                                    <%= booking.home.location %>
                                                </p>
                                            </div>
                                            <div class="text-right">
                                                <div class="text-2xl font-black text-gray-900">Rs <%= booking.totalPrice ? booking.totalPrice.toLocaleString('en-IN') : booking.home.price %></div>
                                                <div class="text-xs text-gray-500 font-medium">Total Paid / Due</div>
                                            </div>
                                        </div>

                                        <!-- Dates & Trip Info Box -->
                                        <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 bg-gray-50 rounded-2xl border border-gray-100 text-xs">
                                            <div>
                                                <span class="text-gray-400 uppercase font-bold tracking-wider block mb-0.5">Check-in</span>
                                                <span class="font-bold text-gray-900 text-sm"><%= booking.checkIn %></span>
                                            </div>
                                            <div>
                                                <span class="text-gray-400 uppercase font-bold tracking-wider block mb-0.5">Check-out</span>
                                                <span class="font-bold text-gray-900 text-sm"><%= booking.checkOut %></span>
                                            </div>
                                            <div>
                                                <span class="text-gray-400 uppercase font-bold tracking-wider block mb-0.5">Duration</span>
                                                <span class="font-bold text-gray-900 text-sm"><%= booking.totalNights || 1 %> Nights</span>
                                            </div>
                                            <div>
                                                <span class="text-gray-400 uppercase font-bold tracking-wider block mb-0.5">Guests</span>
                                                <span class="font-bold text-gray-900 text-sm">
                                                    <%= (booking.guests && booking.guests.adults) || 1 %> Adults
                                                    <% if (booking.guests && booking.guests.children > 0) { %>, <%= booking.guests.children %> Child<% } %>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Add-ons & Notes if any -->
                                        <% if (booking.addOns && booking.addOns.length > 0) { %>
                                            <div class="mt-4 flex flex-wrap items-center gap-1.5">
                                                <span class="text-xs text-gray-400 font-medium mr-1">Add-ons:</span>
                                                <% booking.addOns.forEach(addon => { %>
                                                    <span class="bg-red-50 text-red-600 border border-red-100 text-xs font-semibold px-2.5 py-0.5 rounded-md">
                                                        <%= addon %>
                                                    </span>
                                                <% }) %>
                                            </div>
                                        <% } %>

                                        <% if (booking.specialRequests) { %>
                                            <div class="mt-3 text-xs bg-amber-50 border border-amber-100 text-amber-900 p-3 rounded-xl">
                                                <span class="font-bold">Note to Host:</span> "<%= booking.specialRequests %>"
                                            </div>
                                        <% } %>
                                    </div>

                                    <!-- Bottom Action Buttons -->
                                    <div class="pt-4 border-t border-gray-100 flex items-center justify-between gap-4">
                                        <div class="flex items-center space-x-2 text-xs text-gray-500">
                                            <span class="font-medium">Payment Method:</span>
                                            <span class="bg-gray-100 text-gray-800 font-semibold px-2 py-0.5 rounded"><%= booking.paymentMethod || 'Card' %></span>
                                        </div>

                                        <div class="flex items-center space-x-3">
                                            <a href="/homes/<%= booking.home._id %>" class="px-4 py-2 text-xs font-bold text-gray-700 hover:bg-gray-100 rounded-xl transition">
                                                View Home
                                            </a>
                                            <% if (booking.home.rules) { %>
                                                <a href="/rules/<%= booking.home._id %>" class="px-4 py-2 text-xs font-bold text-blue-600 hover:bg-blue-50 rounded-xl transition">
                                                    House Rules PDF
                                                </a>
                                            <% } %>
                                            <form action="/bookings/cancel/<%= booking._id %>" method="POST" onsubmit="return confirm('Are you sure you want to cancel this booking reservation?');">
                                                <button type="submit" class="px-4 py-2 text-xs font-bold text-red-600 hover:bg-red-50 border border-red-200 rounded-xl transition">
                                                    Cancel Booking
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </article>
                    <% } %>
                <% }) %>
            </div>
        <% } %>
    </main>
</body>
</html>